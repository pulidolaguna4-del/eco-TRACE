// =========================================================
// ESQUEMA DE BASE DE DATOS - ECO-TRACE
// =========================================================
// Refleja exactamente las tablas que creaba el backend de
// FastAPI/SQLModel, para que la base existente siga funcionando.
// Cambios de esquema: editar este archivo y ejecutar
//   npx prisma migrate dev --name <descripcion>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nombre    String  @db.VarChar
  correo    String  @unique(map: "ix_usuarios_correo") @db.VarChar
  // Null en las cuentas creadas con Google
  password  String? @db.VarChar
  // Identificador de la cuenta de Google ("sub" del ID token)
  google_id String? @unique(map: "ix_usuarios_google_id") @db.VarChar
  es_admin  Boolean @default(false)

  puntos               Punto[]
  entregas             Entrega[]
  reportes             Reporte[]
  resenas              Resena[]
  codigos_recuperacion CodigoRecuperacion[]

  // Regalos (marketplace gratuito)
  regalos            Regalo[]        @relation("RegalosPublicados")
  regalos_reservados Regalo[]        @relation("RegalosReservados")
  conversaciones     Conversacion[]
  mensajes           Mensaje[]
  reportes_regalo    ReporteRegalo[]

  @@map("usuarios")
}

model Categoria {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar

  puntos   PuntoCategoria[]
  entregas Entrega[]

  @@map("categorias")
}

model PuntoCategoria {
  punto_id     Int
  categoria_id Int

  punto     Punto     @relation(fields: [punto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoria Categoria @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([punto_id, categoria_id])
  @@map("punto_categoria")
}

model Punto {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar
  descripcion    String   @db.VarChar
  direccion      String   @db.VarChar
  localidad      String   @db.VarChar
  latitud        Float
  longitud       Float
  estado         String   @default("pendiente") @db.VarChar
  fecha_creacion DateTime @default(now()) @db.Timestamp(6)
  foto_url       String?  @db.VarChar
  motivo_rechazo String?  @db.VarChar
  usuario_id     Int

  // Reseñas (HU-23): se recalculan cada vez que se guarda o borra una
  calificacion_promedio Float     @default(0)
  total_resenas         Int       @default(0)
  // Se activa al superar el umbral de reseñas negativas recientes
  revision_prioritaria  Boolean   @default(false)
  motivo_revision       String?   @db.VarChar(255)
  // Última vez que un administrador revisó el punto marcado
  fecha_revision        DateTime? @db.Timestamp(6)

  usuario    Usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categorias PuntoCategoria[]
  entregas   Entrega[]
  reportes   Reporte[]
  resenas    Resena[]

  @@map("puntos")
}

// Una reseña por usuario y punto: si vuelve a calificar, se edita la suya
model Resena {
  id                  Int      @id @default(autoincrement())
  usuario_id          Int
  punto_id            Int
  // 1 a 5 estrellas
  puntuacion          Int
  comentario          String?  @db.VarChar(500)
  fecha               DateTime @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime @default(now()) @updatedAt @db.Timestamp(6)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  punto   Punto   @relation(fields: [punto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([usuario_id, punto_id], map: "uq_resenas_usuario_punto")
  @@index([punto_id], map: "ix_resenas_punto_id")
  @@map("resenas")
}

// Estados: pendiente -> verificada | rechazada (los revisa el administrador)
model Entrega {
  id                  Int      @id @default(autoincrement())
  usuario_id          Int
  punto_id            Int
  // Categoría del material entregado (una de las categorías del punto)
  categoria_id        Int?
  tipo                String   @db.VarChar
  nombre_articulo     String?  @db.VarChar(120)
  cantidad            Float
  unidad              String   @db.VarChar
  // Peso en kilogramos. Si la unidad es "kg" coincide con la cantidad.
  peso                Float?
  // nuevo | bueno | regular | danado (ropa y electrónicos)
  estado_conservacion String?  @db.VarChar(20)
  foto_url            String?  @db.VarChar
  fecha               DateTime @default(now()) @db.Timestamp(6)
  estado              String   @default("pendiente") @db.VarChar
  observacion         String?  @db.VarChar
  observacion_admin   String?  @db.VarChar(500)

  usuario   Usuario    @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  punto     Punto      @relation(fields: [punto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoria Categoria? @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoria_id], map: "ix_entregas_categoria_id")
  @@index([estado], map: "ix_entregas_estado")
  @@map("entregas")
}

model CodigoRecuperacion {
  id               Int     @id @default(autoincrement())
  usuario_id       Int
  codigo           String  @db.VarChar
  // Fecha ISO 8601 con zona horaria (se conserva como texto por compatibilidad)
  fecha_expiracion String  @db.VarChar
  utilizado        Boolean @default(false)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id], map: "ix_codigos_recuperacion_usuario_id")
  @@map("codigos_recuperacion")
}

model Reporte {
  id                Int      @id @default(autoincrement())
  punto_id          Int
  usuario_id        Int
  motivo            String   @db.VarChar(500)
  estado            String   @default("pendiente") @db.VarChar
  fecha_creacion    DateTime @default(now()) @db.Timestamp(6)
  observacion_admin String?  @db.VarChar(500)

  punto   Punto   @relation(fields: [punto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado], map: "ix_reportes_estado")
  @@index([punto_id], map: "ix_reportes_punto_id")
  @@index([usuario_id], map: "ix_reportes_usuario_id")
  @@map("reportes")
}

// =========================================================
// REGALOS (MARKETPLACE GRATUITO) - docs/requisitos/Especificacion_Regalos.md
// =========================================================
// Las coordenadas exactas nunca se devuelven en la API pública: solo
// una zona aproximada (ver regalos.service.js#zonaAproximada).

model Regalo {
  id                  Int       @id @default(autoincrement())
  usuario_id          Int
  titulo              String    @db.VarChar(80)
  descripcion         String?   @db.VarChar(500)
  // madera | papel_carton | plastico | vidrio | metal | ropa | electronicos | muebles | otro
  categoria           String    @db.VarChar(30)
  cantidad            Float
  // kg | unidades
  unidad              String    @db.VarChar(20)
  // disponible | reservado | entregado | cancelado | vencido
  estado              String    @default("disponible") @db.VarChar(20)
  oculto              Boolean   @default(false)
  motivo_ocultamiento String?   @db.VarChar(500)
  latitud             Float
  longitud            Float
  barrio              String?   @db.VarChar(80)
  fotos               String[]  @default([])
  reservado_para_id   Int?
  fecha_creacion      DateTime  @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  fecha_vencimiento   DateTime  @db.Timestamp(6)
  fecha_entrega       DateTime? @db.Timestamp(6)

  usuario        Usuario         @relation("RegalosPublicados", fields: [usuario_id], references: [id], onDelete: Cascade)
  reservado_para Usuario?        @relation("RegalosReservados", fields: [reservado_para_id], references: [id], onDelete: SetNull)
  conversaciones Conversacion[]
  reportes       ReporteRegalo[]

  @@index([estado], map: "ix_regalos_estado")
  @@index([usuario_id], map: "ix_regalos_usuario_id")
  @@map("regalos")
}

model Conversacion {
  id                   Int      @id @default(autoincrement())
  regalo_id            Int
  interesado_id        Int
  fecha_creacion       DateTime @default(now()) @db.Timestamp(6)
  fecha_ultimo_mensaje DateTime @default(now()) @db.Timestamp(6)

  regalo     Regalo    @relation(fields: [regalo_id], references: [id], onDelete: Cascade)
  interesado Usuario   @relation(fields: [interesado_id], references: [id], onDelete: Cascade)
  mensajes   Mensaje[]

  @@unique([regalo_id, interesado_id], map: "uq_conversaciones_regalo_interesado")
  @@index([interesado_id], map: "ix_conversaciones_interesado_id")
  @@map("conversaciones")
}

model Mensaje {
  id              Int       @id @default(autoincrement())
  conversacion_id Int
  // Null en los mensajes del sistema ("Reservado para ti"...)
  remitente_id    Int?
  texto           String    @db.VarChar(1000)
  // usuario | sistema
  tipo            String    @default("usuario") @db.VarChar(20)
  fecha           DateTime  @default(now()) @db.Timestamp(6)
  leido_en        DateTime? @db.Timestamp(6)

  conversacion Conversacion    @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  remitente    Usuario?        @relation(fields: [remitente_id], references: [id], onDelete: Cascade)
  reportes     ReporteRegalo[]

  @@index([conversacion_id, fecha], map: "ix_mensajes_conversacion_fecha")
  @@map("mensajes")
}

model ReporteRegalo {
  id                Int      @id @default(autoincrement())
  regalo_id         Int
  mensaje_id        Int?
  usuario_id        Int
  motivo            String   @db.VarChar(500)
  // pendiente | revisado | descartado
  estado            String   @default("pendiente") @db.VarChar(20)
  observacion_admin String?  @db.VarChar(500)
  fecha_creacion    DateTime @default(now()) @db.Timestamp(6)

  regalo  Regalo   @relation(fields: [regalo_id], references: [id], onDelete: Cascade)
  mensaje Mensaje? @relation(fields: [mensaje_id], references: [id], onDelete: SetNull)
  usuario Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([estado], map: "ix_reportes_regalo_estado")
  @@map("reportes_regalo")
}
